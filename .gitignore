.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.claude/
htmlcov/
dist/
build/
.DS_Store

# The upstream replication package: a 736 MB archive plus a 790,000-entry
# extraction. upstream/MANIFEST.json records the SHA-256 of everything consumed
# from it, so provenance survives without versioning the payload.
upstream/

# Large model weights.
models/*.gguf
models/culture/

# Everything under outputs/ is tracked -- the summary tables, the manifests and
# the reports -- and so is all of figures/, the publication plates. Three
# exceptions, none of which a reader loses anything by not receiving:

# Per-prompt raw LLM responses: regenerable, and too many small files to
# version. Inference logs are covered by the generic logs/ rule below.
outputs/**/raw/

# The booktabs rendering of every report table. Each file re-encodes the CSV of
# the same name beside it and ./run_reports.sh writes it again on demand, so
# versioning it bought nothing and cost 6.6 MB of generated LaTeX -- enough for
# GitHub to report this Python project as 96% TeX.
outputs/reports/tex/

# LaTeX build products.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Runtime logs and temporary atomic-write files.
logs/
*.tmp



