# Local tooling artifacts
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
.claude/
.DS_Store
context/
.env

# The 736 MB upstream replication package; upstream/MANIFEST.json records the
# SHA-256 of everything consumed from it, so provenance survives the exclusion.
upstream/

# Model weights stay out; the training pin and configs stay in.
models/*.gguf
models/culture/*
!models/culture/training/

# outputs/ and figures/ are tracked except what is regenerable and huge:
# per-prompt raw responses and logs.
outputs/**/raw/
outputs/**/raw-*.parquet
logs/
*.tmp

# The LaTeX rendering of outputs/reports/. run_reports.sh writes one .tex per
# table of Machine Bias (Boelaert et al., SMR 2025); every one has a tracked
# .csv twin beside it holding the same numbers, so the tree keeps the data and
# not the typesetting. Regenerate with ./run_reports.sh.
outputs/reports/tex/

# The Hugging Face staging mirror of outputs/, rebuilt by `hub build`. Anchored,
# so it never matches the src/hub package.
/hub/
